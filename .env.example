# Copy to .env and edit.  Every value here has a working default, so .env is
# optional: `docker compose up` works on a clean checkout without it.

# --- Image -------------------------------------------------------------------
# Only distributions verified in CI are supported.  Changing ROS_DISTRO also
# requires the matching base digest: `make digest ROS_DISTRO=<name>`.
ROS_DISTRO=lyrical
ROS_BASE_DIGEST=sha256:0c19f326a339ed770ef1d4c0646a8b53bdb49dd5ff74b6de41ebdb8ac21e1806
IMAGE_NAME=ros2-tutorials

# --- Permanent extra packages ------------------------------------------------
# Baked into the image at build time, unlike `install-ros-packages` inside a
# running container.  ROS names are short; apt names are literal.
# EXTRA_ROS_PACKAGES=demo-nodes-cpp image-tools
# EXTRA_APT_PACKAGES=python3-pytest gdb

# --- Desktop -----------------------------------------------------------------
NOVNC_PORT=6080
SCREEN_GEOMETRY=1600x900x24
# Leave empty for no password.  Required before publishing noVNC on anything
# other than 127.0.0.1.
VNC_PASSWORD=

# --- ROS networking ----------------------------------------------------------
ROS_DOMAIN_ID=42
# SUBNET lets nodes in different compose services find each other; LOCALHOST
# restricts discovery to a single container.
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
