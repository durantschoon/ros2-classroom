#!/usr/bin/env bash
# Automated smoke tests for the ROS 2 tutorial workstation.
#
# These are the claims the README makes, checked against a real container:
# turtlesim runs, the browser desktop answers, packages install, a source
# package builds, and work survives a container recreation.
#
# The container engine is auto-detected: Docker when it is available, otherwise
# rootless Podman.  Override with COMPOSE=... if you need a specific one.  The
# suite is validated against docker compose in CI; the Podman path is
# best-effort, because podman-compose's flag coverage varies by version.
#
# Usage: ./scripts/smoke-container [--keep]
#   --keep   leave containers and volumes in place for inspection
set -euo pipefail

cd "$(dirname "$0")/.."

if [ -z "${COMPOSE:-}" ]; then
    if ! COMPOSE="$(./scripts/compose-command)"; then
        ./scripts/compose-command --explain
        exit 1
    fi
fi

# The self-test runs as its OWN compose project: own volumes, own network, own
# host port.  Its cleanup deletes volumes, so it must never share them with a
# student's real workstation -- and before this, it did: running `make selftest`
# "because something looked wrong" destroyed the student's /workspace.
SELFTEST_PROJECT="${SELFTEST_PROJECT:-ros2-tutorials-selftest}"
COMPOSE="${COMPOSE} -p ${SELFTEST_PROJECT}"
# Exported so the `make package`/`make build` checks below, which run make as a
# student would, address this project too rather than the student's.
export COMPOSE
# A separate host port lets the self-test run beside a student's own desktop
# on 6080.  Inside the container, noVNC always listens on 6080.
export NOVNC_PORT="${SELFTEST_NOVNC_PORT:-6081}"
CONTAINER_NOVNC_PORT=6080
# Its own ROS domain as well.  On Podman 3.x every container lands on Podman's
# default network whatever compose.yaml declares, so with a shared domain the
# self-test's nodes appear in a student's ROS graph and theirs in ours -- and a
# student's own talker could satisfy the DDS check below.  compose.yaml reads
# ROS_DOMAIN_ID from the environment.
export ROS_DOMAIN_ID="${SELFTEST_ROS_DOMAIN_ID:-99}"

echo "using: ${COMPOSE}  (isolated project; host port ${NOVNC_PORT})"
KEEP=0
[ "${1:-}" = "--keep" ] && KEEP=1

passed=0
failed=0
declare -a failures=()

ok()   { printf '  \033[32mPASS\033[0m %s\n' "$1"; passed=$((passed + 1)); }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$1"; failed=$((failed + 1)); failures+=("$1"); }
step() { printf '\n== %s\n' "$1"; }

check() {
    local name="$1"; shift
    if "$@" >/dev/null 2>&1; then ok "${name}"; else bad "${name}"; fi
}

# Run a login-shell command in the desktop container as the workstation user.
in_desktop() {
    $COMPOSE exec -T -u ros -e DISPLAY=:1 desktop bash -lc "$1"
}

cleanup() {
    local status=$?
    if [ "${KEEP}" -eq 1 ]; then
        echo; echo "containers kept (--keep); remove them with: ${COMPOSE} down -v"
    else
        echo; echo '== cleaning up'
        $COMPOSE down -v --remove-orphans >/dev/null 2>&1 || true
    fi
    exit "${status}"
}
trap cleanup EXIT

step 'Build'
$COMPOSE build
ok 'image builds'

step 'Start the desktop'
$COMPOSE up -d desktop

# Readiness is measured by the thing the rest of the suite needs -- exec
# working -- rather than by `ps <service>`, which podman-compose does not
# accept, and which would in any case only report that a container exists.
ready=0
for _ in $(seq 1 30); do
    if in_desktop true >/dev/null 2>&1; then ready=1; break; fi
    sleep 2
done
if [ "${ready}" -eq 1 ]; then
    ok 'desktop container accepts commands'
else
    bad 'desktop container never became ready'
    $COMPOSE logs desktop 2>&1 | tail -20
    exit 1
fi

step 'Image and environment'
# Read the image's configured user directly: podman-compose's `run` prints a
# container id rather than the command's output, so a runtime probe is not
# portable here.
IMAGE="${IMAGE_NAME:-ros2-tutorials}:${ROS_DISTRO:-lyrical}"
ENGINE="$(./scripts/compose-command --engine)"
image_user="$($ENGINE image inspect --format '{{.Config.User}}' "${IMAGE}" 2>/dev/null \
    || $ENGINE image inspect --format '{{.Config.User}}' "localhost/${IMAGE}" 2>/dev/null \
    || true)"
if [ "${image_user}" = 'ros' ]; then
    ok 'the image defaults to the non-root ros user'
else
    bad "the image default user is '${image_user:-unset}', not ros"
fi
# The readiness probe above only proves that `exec` works, and supervisor may
# not have started Xvfb yet: under load this check failed about one run in
# three.  Wait for Xvfb to exist before asking who owns it.
xvfb_user=''
for _ in $(seq 1 30); do
    xvfb_user="$($COMPOSE exec -T desktop ps -o user= -C Xvfb 2>/dev/null | tr -d ' \r' | head -1)"
    [ -n "${xvfb_user}" ] && break
    sleep 1
done
if [ "${xvfb_user}" = 'ros' ]; then
    ok 'desktop programs run as the non-root ros user'
else
    bad 'desktop programs are not running as ros'
fi
check 'ROS_DISTRO is set'       in_desktop '[ -n "$ROS_DISTRO" ]'
check 'the self-test runs in its own ROS domain, not the student default' \
    in_desktop "[ \"\$ROS_DOMAIN_ID\" = \"${ROS_DOMAIN_ID}\" ] && [ \"\$ROS_DOMAIN_ID\" != 42 ]"
check 'ros2 is on PATH'         in_desktop 'command -v ros2'
check 'rosdep is on PATH'       in_desktop 'command -v rosdep'
check 'colcon is on PATH'       in_desktop 'command -v colcon'

step 'Turtlesim'
executables="$(in_desktop 'ros2 pkg executables turtlesim' || true)"
if grep -q 'turtlesim_node' <<<"${executables}" && grep -q 'turtle_teleop_key' <<<"${executables}"; then
    ok 'turtlesim_node and turtle_teleop_key are installed'
else
    bad "turtlesim executables missing (got: ${executables})"
fi

# Start turtlesim on the container's own X display and require it to survive.
if in_desktop 'nohup ros2 run turtlesim turtlesim_node >/tmp/turtlesim.log 2>&1 & sleep 5; pgrep -f turtlesim_node'; then
    ok 'turtlesim stays alive for 5s on the virtual display'
    in_desktop 'pkill -f turtlesim_node' >/dev/null 2>&1 || true
else
    bad "turtlesim exited early: $(in_desktop 'cat /tmp/turtlesim.log' 2>/dev/null | tail -5)"
fi

step 'Browser desktop'
if $COMPOSE exec -T desktop curl --fail --silent --max-time 10 --retry 12 --retry-delay 5 --retry-all-errors \
        "http://127.0.0.1:${CONTAINER_NOVNC_PORT}/vnc.html" >/dev/null 2>&1; then
    ok 'noVNC answers inside the container'
else
    bad 'noVNC did not answer inside the container'
fi

if curl --fail --silent --max-time 10 --retry 6 --retry-delay 5 --retry-all-errors \
        "http://127.0.0.1:${NOVNC_PORT}/vnc.html" >/dev/null 2>&1; then
    ok "noVNC answers on the host at http://localhost:${NOVNC_PORT}"
else
    bad "noVNC did not answer on the host port ${NOVNC_PORT}"
fi

step 'Cross-service DDS discovery'
# Subscribe from the desktop container to a topic published by a separate
# compose service.  This asserts the same property as running the bundled
# talker/listener pair, but reads the message through `exec` instead of
# `compose logs`: podman-compose needs --profile to address a profile service,
# and its `logs` passes a --color flag that Podman 3.x rejects.
$COMPOSE --profile demo up -d talker
sleep 10
if in_desktop 'timeout 30 ros2 topic echo --once /chatter' 2>/dev/null \
        | grep -q 'hello from the talker service'; then
    ok 'a node in one service receives messages from another service'
else
    bad 'no message crossed between compose services'
fi
$COMPOSE --profile demo stop talker >/dev/null 2>&1 || true

step 'Package installation helper'
if in_desktop 'install-ros-packages demo-nodes-cpp' >/dev/null 2>&1; then
    ok 'install-ros-packages installs a ROS short name'
    check 'installed package is runnable' in_desktop 'ros2 pkg executables demo_nodes_cpp | grep -q talker'
else
    bad 'install-ros-packages failed for demo-nodes-cpp'
fi
if in_desktop 'install-ros-packages definitely-not-a-package' >/dev/null 2>&1; then
    bad 'install-ros-packages silently accepted a missing package'
else
    ok 'install-ros-packages fails loudly on a missing package'
fi

step 'Source workspace build'
build_script='
set -e
init-workspace >/dev/null
mkdir -p /workspace/src/smoke_pkg
cd /workspace/src/smoke_pkg
cat > package.xml <<XML
<?xml version="1.0"?>
<package format="3">
  <name>smoke_pkg</name>
  <version>0.0.1</version>
  <description>Smoke test package</description>
  <maintainer email="smoke@example.com">smoke</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
XML
cat > CMakeLists.txt <<CMAKE
cmake_minimum_required(VERSION 3.16)
project(smoke_pkg)
find_package(ament_cmake REQUIRED)
add_executable(smoke_node src/smoke_node.cpp)
install(TARGETS smoke_node DESTINATION lib/\${PROJECT_NAME})
ament_package()
CMAKE
mkdir -p src
cat > src/smoke_node.cpp <<CPP
#include <cstdio>
int main() { std::printf("smoke_pkg overlay works\n"); return 0; }
CPP
cd /workspace
rosdep install --from-paths src --ignore-src --rosdistro "$ROS_DISTRO" -r -y >/dev/null 2>&1 || true
colcon build --symlink-install --packages-select smoke_pkg
'
if in_desktop "${build_script}"; then
    ok 'colcon builds a source package in the persistent workspace'
else
    bad 'colcon build of the smoke package failed'
fi

if in_desktop 'ros2 run smoke_pkg smoke_node' | grep -q 'smoke_pkg overlay works'; then
    ok 'new shells source the workspace overlay automatically'
else
    bad 'the built package did not run from an automatically sourced overlay'
fi

step 'pkg helper: templates, interfaces, and lint'
# `pkg new --template pubsub --build` should produce a real talker/listener
# pair, not just a package that happens to compile.
if in_desktop 'pkg new pkg_smoke_pubsub --template pubsub --build' >/tmp/pkg-smoke-pubsub.log 2>&1; then
    ok 'pkg new --template pubsub builds'
else
    bad 'pkg new --template pubsub failed to build'
fi

check 'templated package registers its talker executable' \
    in_desktop 'ros2 pkg executables pkg_smoke_pubsub | grep -q talker'

if in_desktop 'nohup ros2 run pkg_smoke_pubsub talker >/tmp/pkg-smoke-talker.log 2>&1 & sleep 3; timeout 15 ros2 topic echo --once /chatter' 2>/dev/null \
        | grep -q 'hello from pkg_smoke_pubsub'; then
    ok 'templated pubsub node actually publishes on /chatter'
else
    bad 'templated pubsub node did not publish on /chatter'
fi
# Match by exact process name (no -f): the pattern would otherwise match the
# pkill invocation's own command line and kill the wrong thing.
in_desktop 'pkill -x talker' >/dev/null 2>&1 || true

# `--interfaces` is the highest-risk mode: rosidl wiring in CMakeLists.txt and
# package.xml is easy to get subtly wrong in ways that still build with
# colcon but fail xmllint or `ros2 interface show`.
if in_desktop 'pkg new pkg_smoke_msgs --interfaces --build' >/tmp/pkg-smoke-msgs.log 2>&1; then
    ok 'pkg new --interfaces builds'
else
    bad 'pkg new --interfaces failed to build'
fi
check 'ros2 interface show works for a generated message' \
    in_desktop 'ros2 interface show pkg_smoke_msgs/msg/Temperature'
check 'ros2 interface show works for a generated service' \
    in_desktop 'ros2 interface show pkg_smoke_msgs/srv/AddTwoInts'

# `colcon test` exits 0 even on failure; `pkg test` is supposed to surface the
# real verdict from `colcon test-result`. A freshly generated package is
# expected to pass its own default ament_lint_auto tests cleanly.
pkg_test_output="$(in_desktop 'pkg test pkg_smoke_pubsub' 2>&1 || true)"
if grep -q '0 errors, 0 failures' <<<"${pkg_test_output}"; then
    ok 'pkg test reports a clean lint result for a generated package'
else
    bad "pkg test did not report a clean lint result: $(tail -5 <<<"${pkg_test_output}")"
fi

# The reason `pkg test` exists: `colcon test` exits 0 even when a test fails.
# Break one file's formatting, require a non-zero exit, and put the file back
# so later steps see the package as it was.
broken_status=0
in_desktop 'f=/workspace/src/pkg_smoke_pubsub/src/talker.cpp
cp "$f" /tmp/talker.cpp.orig
sed -i "s/^  rclcpp::init/rclcpp::init/" "$f"
pkg test pkg_smoke_pubsub >/tmp/pkg-smoke-broken.log 2>&1; status=$?
cp /tmp/talker.cpp.orig "$f"
exit "$status"' >/dev/null 2>&1 || broken_status=$?
if [ "${broken_status}" -ne 0 ]; then
    ok 'pkg test exits non-zero when a test really fails'
else
    bad 'pkg test exited 0 although a style test should have failed'
fi

# That run leaves a FAILED result recorded for pkg_smoke_pubsub, on purpose.
# Testing a different package must not report it: the verdict is scoped to the
# package that was tested.  (It once was not, and `make test PKG=a` showed
# package b's stale failures.)
scoped_out="$(in_desktop 'pkg new pkg_smoke_scoped --build >/dev/null 2>&1; pkg test pkg_smoke_scoped' 2>&1 || true)"
if grep -q '0 errors, 0 failures' <<<"${scoped_out}"; then
    ok "pkg test reads only the tested package's results"
else
    bad "pkg test leaked another package's results: $(grep Summary <<<"${scoped_out}" | tail -1)"
fi
# Leave the workspace with passing results recorded, as later steps found it.
in_desktop 'pkg test pkg_smoke_pubsub' >/dev/null 2>&1 || true

step 'Student make targets (run from the host, as a student would)'
# The roadmap's Stage 1 acceptance is about these targets, not `pkg` itself:
# a student should get through package/build/test without typing an engine
# command, and should see each real ros2/colcon command before it runs.
make_out="$(make package PKG=make_smoke TEMPLATE=pubsub 2>&1 || true)"
if grep -q '^+ ros2 pkg create make_smoke' <<<"${make_out}" \
        && grep -q 'next: make build PKG=make_smoke' <<<"${make_out}"; then
    ok 'make package prints the real command and points at make build'
else
    bad "make package output was not as expected: $(tail -3 <<<"${make_out}")"
fi
# A printed command is only useful if it can be pasted back.  The default
# maintainer name has a space; unquoted, it would re-parse as two arguments.
if grep -q -- "--maintainer-name 'ROS Developer'" <<<"${make_out}"; then
    ok 'printed commands quote arguments so they paste correctly'
else
    bad 'printed ros2 pkg create line is not paste-safe'
fi

make_out="$(make build PKG=make_smoke 2>&1 || true)"
if grep -q '^+ colcon build' <<<"${make_out}" \
        && grep -q 'next: make run PKG=make_smoke' <<<"${make_out}"; then
    ok 'make build prints colcon build and points at make run'
else
    bad "make build output was not as expected: $(tail -3 <<<"${make_out}")"
fi

make_out="$(make test PKG=make_smoke 2>&1 || true)"
if grep -q '0 errors, 0 failures' <<<"${make_out}"; then
    ok 'make test reports the real colcon test-result verdict'
else
    bad "make test did not report a clean result: $(tail -3 <<<"${make_out}")"
fi

# `make` exists inside the container, so a workstation target typed in the
# wrong window must explain itself rather than fail with "No rule to make".
# This command is expected to fail, so capture its status without tripping
# the script's own set -e.
guard_status=0
guard_out="$(in_desktop 'cd /workspace && make turtlesim' 2>&1)" || guard_status=$?
if [ "${guard_status}" -ne 0 ] && grep -q 'runs on your own computer' <<<"${guard_out}"; then
    ok 'make typed inside the container explains where to run it'
else
    bad "make inside the container did not explain itself (exit ${guard_status})"
fi

step 'Container helpers: tutorial, init-workspace, pkg refusals'
# `pkg` and `tutorial` are what a student types inside the desktop, and the
# workspace helpers are append-only by design (docs/stages/README.md, guardrail
# 7).  Commands that are expected to fail are captured with `|| status=$?` so
# they do not trip this script's own `set -e`.

in_desktop 'init-workspace' >/dev/null 2>&1 || true
marker_before="$(in_desktop 'md5sum /workspace/.ros-workstation' 2>/dev/null | awk '{print $1}')"
again_status=0
again_out="$(in_desktop 'init-workspace' 2>&1)" || again_status=$?
marker_after="$(in_desktop 'md5sum /workspace/.ros-workstation' 2>/dev/null | awk '{print $1}')"
if [ "${again_status}" -eq 0 ] && grep -q 'already initialized' <<<"${again_out}"; then
    ok 'a second init-workspace reports the workspace is already initialized'
else
    bad "init-workspace did not report an existing workspace (exit ${again_status})"
fi
if [ -n "${marker_before}" ] && [ "${marker_before}" = "${marker_after}" ]; then
    ok 'init-workspace leaves the existing workspace marker untouched'
else
    bad "the workspace marker changed: ${marker_before:-missing} -> ${marker_after:-missing}"
fi

tutorial_status=0
tutorial_usage="$(in_desktop 'tutorial' 2>&1)" || tutorial_status=$?
if [ "${tutorial_status}" -eq 2 ] && grep -qF 'tutorial clone URL [DIRECTORY]' <<<"${tutorial_usage}"; then
    ok 'tutorial with no arguments exits 2 and prints usage'
else
    bad "tutorial with no arguments: exit ${tutorial_status}, not 2 with usage"
fi

# A local repository, so the clone needs no network.
upstream_script='
set -e
mkdir -p /tmp/smoke-upstream
cd /tmp/smoke-upstream
git init -q .
git config user.email smoke@example.com
git config user.name smoke
echo "smoke upstream" > README.md
git add README.md
git commit -qm "first commit"
'
if in_desktop "${upstream_script}" >/dev/null 2>&1; then
    clone_status=0
    clone_out="$(in_desktop 'tutorial clone /tmp/smoke-upstream smoke_clone' 2>&1)" || clone_status=$?
    if [ "${clone_status}" -eq 0 ] \
            && grep -q '^+ git -C /workspace/src clone /tmp/smoke-upstream smoke_clone' <<<"${clone_out}"; then
        ok 'tutorial clone echoes the real git command and succeeds'
    else
        bad "tutorial clone failed or did not echo git (exit ${clone_status})"
    fi
    check 'the clone lands in /workspace/src' \
        in_desktop '[ -f /workspace/src/smoke_clone/README.md ]'
    list_out="$(in_desktop 'tutorial list' 2>&1 || true)"
    if grep -qx 'smoke_clone' <<<"${list_out}"; then
        ok 'tutorial list names the cloned repository'
    else
        bad "tutorial list did not name the clone (got: $(tr '\n' ' ' <<<"${list_out}"))"
    fi
else
    bad 'could not create a local git repository to clone from'
fi

# smoke_pkg was created by the source-workspace step above; reuse it rather
# than building another package.
tbuild_status=0
tbuild_out="$(in_desktop 'tutorial build smoke_pkg' 2>&1)" || tbuild_status=$?
if [ "${tbuild_status}" -eq 0 ] \
        && grep -q '^+ colcon build --symlink-install --packages-select smoke_pkg' <<<"${tbuild_out}"; then
    ok 'tutorial build echoes colcon build --packages-select and succeeds'
else
    bad "tutorial build smoke_pkg failed (exit ${tbuild_status})"
fi

# tutorial deps had no coverage at all.  It needs the network, as the package
# installation step above already does.
tdeps_status=0
tdeps_out="$(in_desktop 'tutorial deps' 2>&1)" || tdeps_status=$?
if [ "${tdeps_status}" -eq 0 ] \
        && grep -q '^+ rosdep update --rosdistro' <<<"${tdeps_out}" \
        && grep -q '^+ rosdep install --from-paths /workspace/src --ignore-src' <<<"${tdeps_out}"; then
    ok 'tutorial deps echoes both rosdep commands and succeeds'
else
    bad "tutorial deps failed (exit ${tdeps_status}): $(tail -3 <<<"${tdeps_out}")"
fi

pkg_status=0
pkg_usage="$(in_desktop 'pkg' 2>&1)" || pkg_status=$?
if [ "${pkg_status}" -eq 2 ] && grep -qF 'pkg new NAME [options]' <<<"${pkg_usage}"; then
    ok 'pkg with no arguments exits 2 and prints usage'
else
    bad "pkg with no arguments: exit ${pkg_status}, not 2 with usage"
fi

mixed_status=0
mixed_out="$(in_desktop 'pkg new smoke_bad_msgs --python --interfaces' 2>&1)" || mixed_status=$?
if [ "${mixed_status}" -eq 1 ] \
        && grep -q 'interface packages must be ament_cmake' <<<"${mixed_out}"; then
    ok 'pkg new --python --interfaces is refused with an explanation'
else
    bad "pkg new --python --interfaces: exit ${mixed_status}, not 1 with an explanation"
fi
check 'the refused interface package was never created' \
    in_desktop '[ ! -e /workspace/src/smoke_bad_msgs ]'

# Student work is append-only: creating a package that already exists must
# refuse, and must leave what is there untouched.
existing_before="$(in_desktop 'md5sum /workspace/src/smoke_pkg/package.xml' 2>/dev/null | awk '{print $1}')"
clobber_status=0
clobber_out="$(in_desktop 'pkg new smoke_pkg' 2>&1)" || clobber_status=$?
existing_after="$(in_desktop 'md5sum /workspace/src/smoke_pkg/package.xml' 2>/dev/null | awk '{print $1}')"
if [ "${clobber_status}" -ne 0 ] && grep -q 'The directory already exists' <<<"${clobber_out}"; then
    ok 'pkg new refuses to create a package that already exists'
else
    bad "pkg new on an existing package: exit ${clobber_status}, expected a refusal"
fi
if [ -n "${existing_before}" ] && [ "${existing_before}" = "${existing_after}" ]; then
    ok 'the existing package is byte-identical after the refusal'
else
    bad "pkg new changed an existing package: ${existing_before:-missing} -> ${existing_after:-missing}"
fi

step 'Persistence across container recreation'
$COMPOSE up -d --force-recreate desktop
sleep 5
if in_desktop '[ -f /workspace/src/smoke_pkg/package.xml ]'; then
    ok 'workspace source survives container recreation'
else
    bad 'workspace source was lost when the container was recreated'
fi
if in_desktop 'ros2 run smoke_pkg smoke_node' | grep -q 'smoke_pkg overlay works'; then
    ok 'built overlay survives container recreation'
else
    bad 'built overlay was lost when the container was recreated'
fi

step 'Result'
printf '%d passed, %d failed\n' "${passed}" "${failed}"
if [ "${failed}" -gt 0 ]; then
    printf 'failed checks:\n'
    printf '  - %s\n' "${failures[@]}"
    exit 1
fi
