#!/bin/sh
# Run a command, dropping engine warnings that are known-harmless HERE, and
# nothing else.  Set VERBOSE=1 to see the unfiltered output.
#
# Only these two are filtered, both from Podman 3.x:
#
#   "Error validating CNI config file ... plugin firewall does not support
#    config version 1.0.0"
#       Podman 3.4 writes cniVersion 1.0.0; Ubuntu 22.04's firewall plugin
#       only advertises 0.4.0, so Podman skips that one plugin.  bridge and
#       portmap both support 1.0.0 and load normally, which is why container
#       networking, host port publishing, and DDS discovery all work.  Fixed
#       properly by Podman 4.4+ or a newer containernetworking-plugins.
#
#   "/ is not a shared mount"
#       Mount propagation for bind mounts.  This project uses named volumes.
#
# Anything else the engine prints reaches the user untouched: the point is to
# stop two specific false alarms, not to hide errors.
set -u

PATTERN='Error validating CNI config file|is not a shared mount'

if [ "${VERBOSE:-0}" = "1" ]; then
    exec "$@"
fi

status_file="$(mktemp)"
trap 'rm -f "${status_file}"' EXIT HUP INT TERM

# Swap the streams so stderr goes through the filter while stdout passes
# straight through, then recover the command's own exit status.
{ { "$@"; echo "$?" > "${status_file}"; } 2>&1 1>&3 | grep -vE "${PATTERN}" >&2; } 3>&1

status="$(cat "${status_file}" 2>/dev/null || echo 1)"
exit "${status:-1}"
