#!/usr/bin/env python3
"""Report whether this host can build and run the workstation, and print the
exact command to fix anything missing.  Changes nothing.

Requirements that are NOT checked here live inside the image; see
docs/host-requirements.md for why the list is this short.

Stdlib only, Python 3.9-compatible: this runs on a student's own machine.
"""

import os
import signal
import subprocess
import sys
from enum import Enum
from pathlib import Path
from typing import List, Optional, Sequence, Tuple

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
COMPOSE_COMMAND = HERE / "compose-command"
MEMINFO = Path("/proc/meminfo")

DISK_GB_WANTED = 15
MEMORY_GB_WANTED = 4

# Printed unconditionally, as they always have been: this is read by a student
# in a terminal, and `make doctor` has never varied on whether stdout is a tty.
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
RESET = "\033[0m"


class Engine(Enum):
    """The two container engines this project supports, and nothing else."""

    DOCKER = "docker"
    PODMAN = "podman"

    @classmethod
    def parse(cls, text: str) -> Optional["Engine"]:
        for member in cls:
            if member.value == text:
                return member
        return None


# --- pure core --------------------------------------------------------------


def ok(text: str) -> str:
    return "  {}ok{}    {}".format(GREEN, RESET, text)


def warn(text: str) -> str:
    return "  {}warn{}  {}".format(YELLOW, RESET, text)


def miss(text: str) -> str:
    return "  {}miss{}  {}".format(RED, RESET, text)


def fix(text: str) -> str:
    return "        -> {}".format(text)


def quoted(text: str) -> List[str]:
    """Another command's output, indented under the line that introduced it."""
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines = lines[:-1]
    return ["        " + line for line in lines]


def major_version(version: str) -> Optional[int]:
    """The leading integer of a version string, or None when there is not one.

    Mirrors `tr -cd '0-9.\\n' | cut -d. -f1`: everything but digits and dots is
    dropped first, so "podman version 3.4.4" and "3.4.4" answer alike.
    """
    kept = "".join(ch for ch in version if ch.isdigit() or ch == ".")
    head = kept.split(".", 1)[0]
    try:
        return int(head)
    except ValueError:
        return None


def says_rootless(info: str) -> bool:
    """What `grep -qi true` made of `podman info`'s Rootless field."""
    return "true" in info.lower()


def parse_df_available_kb(text: str) -> Optional[int]:
    """The Available column of `df -Pk`: line 2, field 4."""
    lines = text.split("\n")
    if len(lines) < 2:
        return None
    fields = lines[1].split()
    if len(fields) < 4:
        return None
    try:
        return int(fields[3])
    except ValueError:
        return None


def parse_meminfo_kb(text: str) -> Optional[int]:
    """MemTotal, in kB, from /proc/meminfo."""
    for line in text.split("\n"):
        if "MemTotal" in line:
            fields = line.split()
            if len(fields) >= 2:
                try:
                    return int(fields[1])
                except ValueError:
                    return None
    return None


def parse_byte_count(text: str) -> Optional[int]:
    """A bare byte count, as `info --format` and `sysctl -n` print one, in kB."""
    try:
        count = int(text.strip())
    except ValueError:
        return None
    return count // 1024 if count > 0 else None


def engine_memory_format(engine: Optional[Engine]) -> Optional[str]:
    """The `info --format` template naming the engine's total memory."""
    if engine is Engine.DOCKER:
        return "{{.MemTotal}}"
    if engine is Engine.PODMAN:
        return "{{.Host.MemTotal}}"
    return None


def gigabytes(kilobytes: int) -> int:
    return kilobytes // 1024 // 1024


def resource_line(label: str, gb: int, wanted: int) -> str:
    if gb >= wanted:
        return ok("{}: {} GB".format(label, gb))
    return warn("{}: {} GB ({} GB recommended)".format(label, gb, wanted))


# --- imperative shell -------------------------------------------------------


def run_for_output(argv: Sequence[str], keep_stderr: bool = False) -> Tuple[int, str]:
    """A command's exit status and its stdout.  Not being runnable is a failure."""
    try:
        completed = subprocess.run(
            list(argv),
            stdout=subprocess.PIPE,
            stderr=None if keep_stderr else subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        return 127, ""
    return completed.returncode, completed.stdout.decode("utf-8", errors="replace")


def capture(argv: Sequence[str], keep_stderr: bool = False) -> Optional[str]:
    """The command's stdout, or None when it could not be run or failed."""
    status, out = run_for_output(argv, keep_stderr=keep_stderr)
    return None if status != 0 else out


def stripped(text: Optional[str]) -> str:
    """A command substitution's value: the output without its trailing newlines."""
    return "" if text is None else text.rstrip("\n")


def engine_version(name: str) -> str:
    """The engine's version, preferring the machine-readable form."""
    formatted = capture([name, "version", "--format", "{{.Client.Version}}"])
    if formatted is not None:
        return stripped(formatted)
    fallback = stripped(capture([name, "--version"]))
    return fallback.split("\n", 1)[0]


def report_engine(out: List[str]) -> Tuple[int, Optional[Engine]]:
    """The 'Container engine' section.  Status 0, and the engine, when one was found."""
    compose = capture([str(COMPOSE_COMMAND)])
    if compose is None:
        out.append(miss("no working docker or podman compose"))
        # --explain exits non-zero here by design; it is its output that matters.
        _, explanation = run_for_output([str(COMPOSE_COMMAND), "--explain"], keep_stderr=True)
        out.extend(quoted(explanation))
        out.append(fix("see docs/host-requirements.md"))
        return 1, None

    out.append(ok("compose: {}".format(stripped(compose))))
    name = stripped(capture([str(COMPOSE_COMMAND), "--engine"]))
    version = engine_version(name)
    out.append(ok("engine:  {} {}".format(name, version)))

    engine = Engine.parse(name)
    if engine is Engine.PODMAN:
        major = major_version(version)
        if major is not None and major < 4:
            out.append(warn(
                "podman {} predates `podman compose`; using podman-compose".format(version)
            ))
            out.append(fix("pip install --user -r requirements-host.txt   (already satisfied)"))
        info = capture([name, "info", "--format", "{{.Host.Security.Rootless}}"])
        if info is not None and says_rootless(info):
            out.append(ok("podman is running rootless"))
        else:
            out.append(warn("podman is running as root; rootless is recommended"))
    return 0, engine


def memory_kb(engine: Optional[Engine]) -> Tuple[Optional[int], str]:
    """Total memory in kB and the label to report it under, from the first source
    that answers.

    Linux has /proc/meminfo.  macOS does not, and there the engine runs in a VM
    with a memory limit of its own, so the engine is asked before the host is.
    """
    try:
        meminfo = MEMINFO.read_text(errors="replace")
    except OSError:
        meminfo = ""
    mem_kb = parse_meminfo_kb(meminfo)
    if mem_kb is not None:
        return mem_kb, "memory"

    template = engine_memory_format(engine)
    if engine is not None and template is not None:
        mem_kb = parse_byte_count(stripped(capture([engine.value, "info", "--format", template])))
        if mem_kb is not None:
            return mem_kb, "memory ({}'s VM)".format(engine.value)

    return parse_byte_count(stripped(capture(["sysctl", "-n", "hw.memsize"]))), "memory"


def report_resources(out: List[str], engine: Optional[Engine]) -> None:
    """The 'Resources' section.  A measurement that cannot be taken is left out."""
    disk = capture(["df", "-Pk", "."])
    if disk is not None:
        disk_kb = parse_df_available_kb(disk)
        if disk_kb is not None:
            out.append(resource_line("disk free", gigabytes(disk_kb), DISK_GB_WANTED))
    mem_kb, label = memory_kb(engine)
    if mem_kb is not None:
        out.append(resource_line(label, gigabytes(mem_kb), MEMORY_GB_WANTED))


def main() -> int:
    # The disk check measures the filesystem the repository is on, so the
    # working directory matters, exactly as it did in the shell.
    os.chdir(str(REPO))

    out = []  # type: List[str]
    out.append("Container engine")
    status, engine = report_engine(out)

    out.append("")
    out.append("Resources")
    report_resources(out, engine)

    out.append("")
    if status == 0:
        out.append("Ready: run `make image`, then `make up`.")
    else:
        out.append("Not ready; see docs/host-requirements.md.")

    for line in out:
        print(line)
    return status


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    sys.exit(main())
