#!/bin/sh
set -eu

executable=${1:?usage: run-in-guix-container EXECUTABLE}

if [ -z "${DISPLAY:-}" ] || [ ! -d /tmp/.X11-unix ]; then
    echo "an X11/XWayland display is required" >&2
    exit 1
fi

if ! command -v xhost >/dev/null 2>&1; then
    echo "xhost is required to authorize the Guix container" >&2
    exit 1
fi

cleanup() {
    xhost -SI:localuser:"$USER" >/dev/null 2>&1 || true
}
trap cleanup EXIT HUP INT TERM

xhost +SI:localuser:"$USER" >/dev/null

guix time-machine -C channels.scm \
    --max-jobs=1 \
    -- \
    shell -m manifest.scm \
    --container \
    --network \
    --preserve=DISPLAY \
    --expose=/tmp/.X11-unix \
    -- sh -c 'exec "$GUIX_ENVIRONMENT/lib/turtlesim/$1"' sh "$executable"
